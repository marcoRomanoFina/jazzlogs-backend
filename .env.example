SUPABASE_JWKS_URI=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

DATABASE_URL=jdbc:postgresql://YOUR-DB-HOST:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=YOUR-DB-PASSWORD

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR-LOCAL-NEO4J-PASSWORD

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=YOUR-LOCAL-MINIO-PASSWORD


SPOTIFY_CLIENT_ID=YOUR-SPOTIFY-CLIENT-ID
SPOTIFY_CLIENT_SECRET=YOUR-SPOTIFY-CLIENT-SECRET


OPENAI_API_KEY=YOUR-OPENAI-API-KEY

# Observability — nothing to set for local development: traces and metrics go
# to the `observability` container (Grafana at http://localhost:3001).
# Only a deployed environment sets these. For Grafana Cloud (your stack >
# OpenTelemetry): the endpoint is OTEL_EXPORTER_OTLP_ENDPOINT, and the token
# is what follows "Basic " in OTEL_EXPORTER_OTLP_HEADERS — just that part.
# OBSERVABILITY_EXPORT_ENABLED=true
# APP_ENVIRONMENT=production
# OTLP_ENDPOINT=
# OTLP_TOKEN=
# Agent traces include the user's messages and tool results unless this is false.
# AGENT_TRACE_CONTENT=false
